; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Smarves"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Communes="*res://scripts/socle/communes.gd"
Registre="*res://scripts/socle/registre.gd"
Version="*res://scripts/socle/version.gd"
Game="*res://scripts/game_state.gd"
Sfx="*res://scripts/sfx.gd"
Settings="*res://scripts/settings.gd"
Biens="*res://scripts/biens.gd"
Carnet="*res://scripts/carnet.gd"
Compte="*res://scripts/socle/compte.gd"
Voisinage="*res://scripts/socle/voisinage.gd"
Tableau="*res://scripts/socle/tableau.gd"
Bienvenue="*res://scripts/bienvenue.gd"
Tactile="*res://scripts/tactile/tactile.gd"
Carte="*res://scripts/carte.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/smarves_version/plugin.cfg")

[gui]

theme/custom_font="res://assets/polices/texte.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="vulkan"
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
